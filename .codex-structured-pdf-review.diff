+                   AND (
+                     ?2 = 'all'
+                     OR (?2 = 'failed' AND visual_module_analysis.status = 'failed')
+                     OR (?2 = 'needed' AND visual_module_analysis.status IS NULL)
+                   )
+                 ORDER BY content_blocks.document_id, content_blocks.page_number,
+                          content_blocks.ordinal",
