+  if (cached) {
+    return Promise.resolve(cached);
+  }
+
+  const existing = requests.get(pageId);
+  if (existing) {
+    return existing;
+  }
+
+  let request: Promise<string | null>;
+  request = Promise.resolve()
+    .then(loader)
+    .then((dataUrl) => {
+      if (dataUrl) {
